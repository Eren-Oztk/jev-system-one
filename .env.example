# systemone/.env.example

# Jev (TypeSafe) — console.typesafe.ai/keys
# GÜVENLİ SAKLAMA: parolayı sohbete yazma. Terminalde:
#   hermes-vault add --id typesafe --type api_key --label "TypeSafe Jev" --data '{"value":"<KEY>"}'
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest

# Jev yoksa kullanılan LLM fallback (geliştirme/ölçüm; kalibre değil)
DEEPSEEK_API_KEY=
SYSTEMONE_FALLBACK_BASE_URL=https://api.deepseek.com/v1
SYSTEMONE_FALLBACK_MODEL=deepseek-flash
# Fallback maliyetini hesaplamak istersen (USD / milyon token):
# SYSTEMONE_FALLBACK_PRICE_IN_USD_PER_MTOK=0.28
# SYSTEMONE_FALLBACK_PRICE_OUT_USD_PER_MTOK=0.42
